# Copy to .env and adjust:  cp .env.example .env
# Every value has a working local-development default in compose.yaml, so the stack
# also starts without a .env file. Never commit real credentials: .env is git-ignored.

# --- Game data sources --------------------------------------------------------
# Steam + SteamSpy need no key. Seconds between Steam store calls (Steam allows
# roughly 200 app-detail requests per 5 minutes).
STEAM_REQUEST_INTERVAL=1.5

# IGDB (optional): create a Twitch application, see https://api-docs.igdb.com/#account-creation
# With both set, a monthly IGDB ingestion job is scheduled.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG (optional, legacy): api.rawg.io was unreachable when this was written
# (HTTP 522, 2026-11-10). With a key set, the RAWG jobs are scheduled again.
RAWG_API_KEY=

# --- Machine learning ---------------------------------------------------------
# Training is skipped when fewer games than this have a Metacritic score.
ML_MIN_TRAINING_ROWS=200
# How often (seconds) the API re-checks which model version is the champion.
MODEL_REFRESH_SECONDS=60

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=game_insight
POSTGRES_PASSWORD=game_insight
POSTGRES_DB=game_insight

# --- Backend ------------------------------------------------------------------
# Signs the admin panel session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me

# Admin panel account created on first startup (http://localhost:8000/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

# --- Dashboard sign-in (Rauthy) -----------------------------------------------
# Rauthy's first admin account (http://localhost:8080/auth/v1/admin). Read only when
# Rauthy's database is empty; change the password there afterwards.
RAUTHY_ADMIN_EMAIL=admin@localhost
RAUTHY_ADMIN_PASSWORD=DevOnlyAdminPassword1!
# Encrypts secrets in Rauthy's database, as "<id>/<base64 of 32 random bytes>".
# Generate one with:  docker run --rm ghcr.io/sebadob/rauthy:0.37.2 generate-enc-key
# Keep the old key listed (one per line) when you add a new one, or Rauthy cannot read
# what it encrypted with it.
RAUTHY_ENC_KEYS=devonly/e6GPTA+a9CbMXmHNlnUElTUxXB2rNZWim5tjYzg8XPw=
RAUTHY_ENC_KEY_ACTIVE=devonly
# Internal secrets of Rauthy's embedded database, at least 16 characters each.
RAUTHY_SECRET_RAFT=dev-only-raft-secret-change-me
RAUTHY_SECRET_API=dev-only-api-secret-change-me

# --- Host ports ---------------------------------------------------------------
BACKEND_PORT=8000
# Also part of Rauthy's public URL and the dashboard's sign-in redirect.
FRONTEND_PORT=8080
# Inbox of the mail catcher that receives Rauthy's e-mails.
MAIL_UI_PORT=8025
FLOWER_PORT=5555
POSTGRES_PORT=5433
MLFLOW_PORT=5000
