# Copy to .env and adjust:  cp .env.example .env
# Every value except RAWG_API_KEY has a working local-development default in compose.yaml,
# so the stack also starts without a .env file.

# --- RAWG API -----------------------------------------------------------------
# Needed only for live ingestion (the Celery fetch tasks). The dashboard works without
# it on the bundled CSV sample. Get a free key at https://rawg.io/apidocs
# Never commit a real key: .env is git-ignored.
RAWG_API_KEY=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=game_insight
POSTGRES_PASSWORD=game_insight
POSTGRES_DB=game_insight

# --- Backend ------------------------------------------------------------------
# Signs the admin panel session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me

# Admin panel account created on first startup (http://localhost:8000/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

# --- Host ports ---------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8501
FLOWER_PORT=5555
POSTGRES_PORT=5433
